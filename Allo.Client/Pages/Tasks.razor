@page "/tasks"
@using Allo.Shared.Lists
@using Allo.Shared.Models
@using Allo.Shared.Sync
@implements IDisposable
@inject LocalStore Store
@inject TaskActions Actions
@inject UiState Ui
@inject AlloAuthStateProvider Auth
@inject IDialogService Dialogs

<PageTitle>allo · tasks</PageTitle>

<div class="list-page">
    @* Always shown, even with one list: it's also where a new list is made. Hiding it
       until a second list existed is what made several lists unreachable. *@
    <div class="list-selectors">
        <MudSelect @key="_pickerVersion" T="Guid" Value="Ui.TaskListId" ValueChanged="SelectListAsync" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Label="List">
            @foreach (var list in Lists)
            {
                <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
            }
            <MudSelectItem T="Guid" Value="NewListChoice">
                <span class="new-list-choice">+ New list…</span>
            </MudSelectItem>
        </MudSelect>
        <MudMenu Icon="@Icons.Material.Filled.Edit" AriaLabel="Manage this list" Dense="true"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="RenameListAsync">
                Rename @CurrentList?.Name
            </MudMenuItem>
            @* The last list can't go: the screen would have nowhere to put anything. *@
            @if (Lists.Count > 1)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteListAsync">
                    Delete @CurrentList?.Name
                </MudMenuItem>
            }
        </MudMenu>
    </div>

    @if (_sections.IsEmpty)
    {
        <MudStack Spacing="1" AlignItems="AlignItems.Center" Class="empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1">Nothing to do</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Add your first task below.</MudText>
        </MudStack>
    }
    else
    {
        @foreach (var group in _sections.ToDo)
        {
            <div class="category-header">
                <MudText Typo="Typo.overline">@group.Priority.Label()</MudText>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@group.Tasks.Count</MudText>
            </div>
            @foreach (var task in group.Tasks)
            {
                <TaskRow @key="task.Id" Entry="task" Today="_today"
                         OnToggle="@(done => ToggleAsync(task, done))"
                         OnEdit="@(() => EditAsync(task))" />
            }
        }

        @* Done: out of the way at the bottom, still reviewable, one tap puts it back. *@
        @if (_sections.DoneCount > 0)
        {
            <div class="checked-section">
                <div class="checked-header">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                        Done · @_sections.DoneCount
                    </MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               Style="text-transform: none;" StartIcon="@Icons.Material.Filled.ClearAll"
                               OnClick="ClearDoneAsync">Clear</MudButton>
                </div>
                @foreach (var task in _sections.Done)
                {
                    <TaskRow @key="task.Id" Entry="task" Today="_today"
                             OnToggle="@(done => ToggleAsync(task, done))"
                             OnEdit="@(() => EditAsync(task))" />
                }
            </div>
        }
    }
</div>

<TaskAddBar TaskListId="Ui.TaskListId" UserId="UserId" OnEditLast="EditAsync" />

@code {
    private TaskSections _sections = new([], []);
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);

    private Guid UserId => Auth.User?.Id ?? Guid.Empty;

    private List<TaskList> Lists => [.. TaskView.Lists(Store)];

    private TaskList? CurrentList => Lists.FirstOrDefault(l => l.Id == Ui.TaskListId);

    // Stands in for "+ New list…" in the picker. Never a real list id.
    private static readonly Guid NewListChoice = Guid.Empty;

    // MudSelect takes the picked value into its own state before asking this page. When
    // the answer is "no change" — a new list cancelled — nothing pushes it back, and it
    // goes on showing "+ New list…" over the list you're really on. A new key rebuilds it
    // from the real selection.
    private int _pickerVersion;

    private async Task SelectListAsync(Guid listId)
    {
        if (listId == NewListChoice)
        {
            // Picking "+ New list…" doesn't switch lists; making one does, below.
            await CreateListAsync();
            _pickerVersion++;
            return;
        }
        await Ui.SetTaskListAsync(listId);
    }

    private async Task CreateListAsync()
    {
        if (await Prompts.RenameAsync(Dialogs, "New task list", "") is { } name)
        {
            var list = await Actions.CreateListAsync(name);
            // You just made it, so you're about to put something in it.
            await Ui.SetTaskListAsync(list.Id);
        }
        StateHasChanged();
    }

    private async Task RenameListAsync()
    {
        if (CurrentList is { } list
            && await Prompts.RenameAsync(Dialogs, "Rename list", list.Name) is { } name)
        {
            await Actions.RenameListAsync(list, name);
        }
    }

    private async Task DeleteListAsync()
    {
        if (CurrentList is not { } list)
        {
            return;
        }
        var count = TaskView.Tasks(Store, list.Id).Count();
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Delete {list.Name}?",
            count == 0 ? "The list is empty." : count == 1 ? "The task on it will go too." : $"{count} tasks on it will go too.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true && await Actions.DeleteListAsync(list))
        {
            Ui.FallBackIfMissing();
            await Ui.SetTaskListAsync(Ui.TaskListId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += Refresh;
        Ui.Changed += Refresh;
        await Ui.LoadAsync();
        Rebuild();
    }

    private void Refresh() => InvokeAsync(() =>
    {
        Rebuild();
        StateHasChanged();
    });

    private void Rebuild()
    {
        Ui.FallBackIfMissing();
        // Local date, not UTC: "today" has to mean the day the person is actually having.
        _today = DateOnly.FromDateTime(DateTime.Now);
        _sections = TaskView.Build(Store, Ui.TaskListId, _today);
    }

    private Task ToggleAsync(TaskEntry task, bool isDone) => Actions.SetDoneAsync(task, isDone, UserId);

    private async Task EditAsync(TaskEntry task)
    {
        var parameters = new DialogParameters<TaskEditDialog> { { x => x.Entry, task } };
        await Dialogs.ShowAsync<TaskEditDialog>(null, parameters, new DialogOptions
        {
            FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true,
            BackdropClick = false,
        });
    }

    private async Task ClearDoneAsync() => await Actions.ClearDoneAsync(Ui.TaskListId);

    public void Dispose()
    {
        Store.Changed -= Refresh;
        Ui.Changed -= Refresh;
    }
}
