@page "/tasks"
@using Allo.Shared.Lists
@using Allo.Shared.Models
@using Allo.Shared.Sync
@implements IAsyncDisposable
@inject LocalStore Store
@inject TaskActions Actions
@inject UiState Ui
@inject AlloAuthStateProvider Auth
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>allo · tasks</PageTitle>

<div class="list-page" @ref="_listArea" data-long-press="@(Lists.Count > 1 ? "on" : "off")">
    @* Always shown, even with one list: it's also where a new list is made. Hiding it
       until a second list existed is what made several lists unreachable. *@
    <div class="list-selectors">
        <MudSelect @key="_pickerVersion" T="Guid" Value="Ui.TaskListId" ValueChanged="SelectListAsync" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Label="List">
            @foreach (var list in Lists)
            {
                <MudSelectItem T="Guid" Value="@list.Id">@list.Name</MudSelectItem>
            }
            <MudSelectItem T="Guid" Value="NewListChoice">
                <span class="new-list-choice">+ New list…</span>
            </MudSelectItem>
        </MudSelect>
        <MudMenu Icon="@Icons.Material.Filled.Edit" AriaLabel="Manage this list" Dense="true"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            @* The findable way into selection; long-press on a row is the quick one. Only
               offered when there's another list to move tasks to. *@
            @if (Lists.Count > 1 && !_sections.IsEmpty)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Checklist" OnClick="StartSelectingAsync">
                    Select tasks
                </MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="RenameListAsync">
                Rename @CurrentList?.Name
            </MudMenuItem>
            @* The last list can't go: the screen would have nowhere to put anything. *@
            @if (Lists.Count > 1)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteListAsync">
                    Delete @CurrentList?.Name
                </MudMenuItem>
            }
        </MudMenu>
    </div>

    @if (_sections.IsEmpty)
    {
        <MudStack Spacing="1" AlignItems="AlignItems.Center" Class="empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1">Nothing to do</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Add your first task below.</MudText>
        </MudStack>
    }
    else
    {
        @foreach (var group in _sections.ToDo)
        {
            <div class="category-header">
                <MudText Typo="Typo.overline">@group.Priority.Label()</MudText>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@group.Tasks.Count</MudText>
            </div>
            @foreach (var task in group.Tasks)
            {
                <TaskRow @key="task.Id" Entry="task" Today="_today"
                         Selecting="_selecting" Selected="@_selected.Contains(task.Id)"
                         OnSelect="@(() => ToggleSelected(task.Id))"
                         OnToggle="@(done => ToggleAsync(task, done))"
                         OnEdit="@(() => EditAsync(task))" />
            }
        }

        @* Done: out of the way at the bottom, still reviewable, one tap puts it back. *@
        @if (_sections.DoneCount > 0)
        {
            <div class="checked-section">
                <div class="checked-header">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                        Done · @_sections.DoneCount
                    </MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               Style="text-transform: none;" StartIcon="@Icons.Material.Filled.ClearAll"
                               OnClick="ClearDoneAsync">Clear</MudButton>
                </div>
                @foreach (var task in _sections.Done)
                {
                    <TaskRow @key="task.Id" Entry="task" Today="_today"
                             Selecting="_selecting" Selected="@_selected.Contains(task.Id)"
                             OnSelect="@(() => ToggleSelected(task.Id))"
                             OnToggle="@(done => ToggleAsync(task, done))"
                             OnEdit="@(() => EditAsync(task))" />
                }
            </div>
        }
    }
</div>

@if (_selecting)
{
    @* Replaces the add bar while selecting, so the actions sit where the thumb already is. *@
    <div class="add-bar selection-bar">
        <MudText Typo="Typo.subtitle2">@SelectionLabel</MudText>
        <MudSpacer />
        <MudMenu Label="Move to…" Variant="Variant.Filled" Color="Color.Primary" Dense="true"
                 Disabled="@(_selected.Count == 0 || OtherLists.Count == 0)"
                 AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight">
            @foreach (var list in OtherLists)
            {
                <MudMenuItem OnClick="@(() => MoveSelectedAsync(list))">@list.Name</MudMenuItem>
            }
        </MudMenu>
        <MudButton Variant="Variant.Text" OnClick="CancelSelectionAsync">Cancel</MudButton>
    </div>
}
else
{
    <TaskAddBar TaskListId="Ui.TaskListId" UserId="UserId" OnEditLast="EditAsync" />
}

@code {
    private TaskSections _sections = new([], []);
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);

    private Guid UserId => Auth.User?.Id ?? Guid.Empty;

    private List<TaskList> Lists => [.. TaskView.Lists(Store)];

    private TaskList? CurrentList => Lists.FirstOrDefault(l => l.Id == Ui.TaskListId);

    // Stands in for "+ New list…" in the picker. Never a real list id.
    private static readonly Guid NewListChoice = Guid.Empty;

    // MudSelect takes the picked value into its own state before asking this page. When
    // the answer is "no change" — a new list cancelled — nothing pushes it back, and it
    // goes on showing "+ New list…" over the list you're really on. A new key rebuilds it
    // from the real selection.
    private int _pickerVersion;

    private async Task SelectListAsync(Guid listId)
    {
        await CancelSelectionAsync();
        if (listId == NewListChoice)
        {
            // Picking "+ New list…" doesn't switch lists; making one does, below.
            await CreateListAsync();
            _pickerVersion++;
            return;
        }
        await Ui.SetTaskListAsync(listId);
    }

    private async Task CreateListAsync()
    {
        if (await Prompts.RenameAsync(Dialogs, "New task list", "") is { } name)
        {
            var list = await Actions.CreateListAsync(name);
            // You just made it, so you're about to put something in it.
            await Ui.SetTaskListAsync(list.Id);
        }
        StateHasChanged();
    }

    private async Task RenameListAsync()
    {
        if (CurrentList is { } list
            && await Prompts.RenameAsync(Dialogs, "Rename list", list.Name) is { } name)
        {
            await Actions.RenameListAsync(list, name);
        }
    }

    private async Task DeleteListAsync()
    {
        if (CurrentList is not { } list)
        {
            return;
        }
        var count = TaskView.Tasks(Store, list.Id).Count();
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Delete {list.Name}?",
            count == 0 ? "The list is empty." : count == 1 ? "The task on it will go too." : $"{count} tasks on it will go too.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true && await Actions.DeleteListAsync(list))
        {
            Ui.FallBackIfMissing();
            await Ui.SetTaskListAsync(Ui.TaskListId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += Refresh;
        Ui.Changed += Refresh;
        await Ui.LoadAsync();
        Rebuild();
    }

    private void Refresh() => InvokeAsync(() =>
    {
        Rebuild();
        StateHasChanged();
    });

    private void Rebuild()
    {
        Ui.FallBackIfMissing();
        // Local date, not UTC: "today" has to mean the day the person is actually having.
        _today = DateOnly.FromDateTime(DateTime.Now);
        _sections = TaskView.Build(Store, Ui.TaskListId, _today);
        if (_selecting)
        {
            _selected.IntersectWith(TaskView.Tasks(Store, Ui.TaskListId).Select(t => t.Id));
        }
    }

    private Task ToggleAsync(TaskEntry task, bool isDone) => Actions.SetDoneAsync(task, isDone, UserId);

    private async Task EditAsync(TaskEntry task)
    {
        var from = task.TaskListId;
        var parameters = new DialogParameters<TaskEditDialog> { { x => x.Entry, task } };
        var dialog = await Dialogs.ShowAsync<TaskEditDialog>(null, parameters, new DialogOptions
        {
            FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true,
            BackdropClick = false,
        });
        await dialog.Result;

        // A task moved to another list leaves this screen, which looks exactly like it was
        // deleted. Say where it went, and offer the way back.
        if (!task.IsDeleted && task.TaskListId != from)
        {
            var to = Lists.FirstOrDefault(l => l.Id == task.TaskListId)?.Name ?? "another list";
            ShowMoved($"Moved to {to}", () => UndoMoveAsync(task.Id, from));
        }
    }

    // One snackbar for single and batch moves, so they behave alike: eight seconds to read it
    // and reach Undo, then gone. Stated explicitly — a snackbar with an action button waits
    // for a tap by default and never went away at all. MudBlazor's default fades (1s in, 2s
    // out) also made "8 seconds" last 11; quick fades keep it near 9.
    private void ShowMoved(string message, Func<Task> undo) =>
        Snackbar.Add(message, Severity.Normal, options =>
        {
            options.RequireInteraction = false;
            options.VisibleStateDuration = 8000;
            options.ShowTransitionDuration = 300;
            options.HideTransitionDuration = 500;
            options.Action = "Undo";
            options.ActionColor = Color.Primary;
            options.OnClick = _ => undo();
        });

    // --- Selection ------------------------------------------------------------------------

    private ElementReference _listArea;
    private DotNetObjectReference<Tasks>? _self;
    private bool _selecting;
    private readonly HashSet<Guid> _selected = [];

    private List<TaskList> OtherLists => [.. Lists.Where(l => l.Id != Ui.TaskListId)];

    private string SelectionLabel => _selected.Count switch
    {
        0 => "Tap tasks to select",
        1 => "1 selected",
        var n => $"{n} selected",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("alloLongPress.register", _listArea, _self);
        }
    }

    [JSInvokable]
    public Task OnLongPress(string taskId) => InvokeAsync(async () =>
    {
        if (Guid.TryParse(taskId, out var id) && Lists.Count > 1)
        {
            await EnterSelectionAsync();
            _selected.Add(id);
            StateHasChanged();
        }
    });

    // Android's back gesture while selecting: end selection rather than leave the page.
    [JSInvokable]
    public Task OnSelectionBack() => InvokeAsync(() =>
    {
        ClearSelection();
        StateHasChanged();
    });

    private Task StartSelectingAsync() => EnterSelectionAsync();

    private async Task EnterSelectionAsync()
    {
        if (!_selecting)
        {
            _selecting = true;
            await Js.InvokeVoidAsync("alloLongPress.enterSelection");
        }
    }

    private void ClearSelection()
    {
        _selecting = false;
        _selected.Clear();
    }

    private async Task CancelSelectionAsync()
    {
        if (_selecting)
        {
            ClearSelection();
            await Js.InvokeVoidAsync("alloLongPress.leaveSelection");
        }
    }

    private void ToggleSelected(Guid taskId)
    {
        if (!_selected.Remove(taskId))
        {
            _selected.Add(taskId);
        }
    }

    private async Task MoveSelectedAsync(TaskList target)
    {
        var tasks = TaskView.Tasks(Store, Ui.TaskListId).Where(t => _selected.Contains(t.Id)).ToList();
        var moves = await Actions.MoveManyAsync(tasks, target.Id);
        await CancelSelectionAsync();
        if (moves.Count > 0)
        {
            ShowMoved(moves.Count == 1 ? $"Moved 1 task to {target.Name}" : $"Moved {moves.Count} tasks to {target.Name}",
                () => UndoMovesAsync(moves));
        }
    }

    // Each task back to its own list, by id, so a sync in between can't leave Undo acting
    // on stale copies.
    private async Task UndoMovesAsync(IReadOnlyList<TaskMove> moves)
    {
        foreach (var move in moves)
        {
            await UndoMoveAsync(move.TaskId, move.FromListId);
        }
    }

    // By id rather than the object the sheet edited: a sync in the meantime replaces the
    // device's copy, and the move-back should apply to the current one.
    private async Task UndoMoveAsync(Guid taskId, Guid listId)
    {
        if (Store.Tasks.FirstOrDefault(t => t.Id == taskId && !t.IsDeleted) is { } task)
        {
            await Actions.MoveAsync(task, listId);
        }
    }

    private async Task ClearDoneAsync() => await Actions.ClearDoneAsync(Ui.TaskListId);

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= Refresh;
        Ui.Changed -= Refresh;
        await Js.InvokeVoidAsync("alloLongPress.unregister");
        _self?.Dispose();
    }
}
