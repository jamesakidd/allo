@using Allo.Shared.Lists
@using Allo.Shared.Models
@using Allo.Shared.Sync
@inject LocalStore Store

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent>
        <MudList T="Guid" Class="picker-list">
            @foreach (var category in Categories)
            {
                <MudListItem T="Guid" OnClick="@(() => Dialog.Close(DialogResult.Ok(category.Id)))"
                             Icon="@(category.Id == Selected ? Icons.Material.Filled.Check : null)">
                    @Indent(category)@category.Name
                </MudListItem>
            }
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Category";
    [Parameter] public Guid Selected { get; set; }
    [Parameter] public Guid? Exclude { get; set; }

    private IEnumerable<Category> Categories => CategoryTree.Ordered(Store.Categories)
        .Where(c => c.Id != Exclude);

    private static string Indent(Category category) => category.ParentId is null ? "" : "— ";
}
