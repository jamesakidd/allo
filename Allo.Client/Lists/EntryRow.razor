@using Allo.Shared.Models

@* Whole row is the tap target for editing; the checkbox keeps its own generous area. *@
<div class="entry-row @(Entry.IsChecked ? "entry-checked" : "")">
    <MudCheckBox T="bool" Value="Entry.IsChecked" ValueChanged="@(v => OnToggle.InvokeAsync(v))"
                 Color="Color.Primary" Size="Size.Large" Dense="false"
                 aria-label="@($"Check off {Name}")" />
    <div class="entry-body" @onclick="@(() => OnEdit.InvokeAsync())">
        <div class="entry-name">
            <MudText Typo="Typo.body1">@Name</MudText>
            @if (Quantity is { Length: > 0 })
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Quantity</MudChip>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Entry.Note))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Entry.Note</MudText>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ListEntry Entry { get; set; } = null!;
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public EventCallback<bool> OnToggle { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }

    // "2", "1.5 kg": a quantity of one each is just the item name.
    private string? Quantity => Entry.Quantity == 1 && Entry.Unit == Unit.Each
        ? null
        : Entry.Unit == Unit.Each
            ? Format(Entry.Quantity)
            : $"{Format(Entry.Quantity)} {Entry.Unit.ToCode()}";

    private static string Format(decimal value) => value == decimal.Truncate(value)
        ? value.ToString("0")
        : value.ToString("0.##");
}
