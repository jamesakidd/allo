@inherits LayoutComponentBase
@implements IDisposable
@inject AlloAuthStateProvider Auth
@inject NavigationManager Navigation
@inject SyncCoordinator Sync
@inject Allo.Shared.Sync.LocalStore Store
@inject IDialogService Dialogs

<MudLayout>
    <UpdatePrompt />
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="0" Dense="true">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               aria-label="Menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
                <img src="logo-mark.png" alt="" class="ml-2" style="height: 1.75rem;" />
                <MudText Typo="Typo.h6" Class="ml-2">allo</MudText>
                <MudSpacer />
                <SyncStatus />
            </MudAppBar>
            <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary" Elevation="1">
                <MudDrawerHeader>
                    <MudText Typo="Typo.subtitle1">@Auth.User?.DisplayName</MudText>
                </MudDrawerHeader>
                <MudNavMenu>
                    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Checklist">List</MudNavLink>
                    <MudNavLink Href="tasks" Icon="@Icons.Material.Filled.TaskAlt">Tasks</MudNavLink>
                    <MudNavLink Href="stores" Icon="@Icons.Material.Filled.Storefront">Stores</MudNavLink>
                    <MudNavLink Href="categories" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
                    <MudNavLink Href="lists" Icon="@Icons.Material.Filled.ListAlt">Lists</MudNavLink>
                    <MudNavLink Href="family" Icon="@Icons.Material.Filled.People">Family</MudNavLink>
                    <MudNavLink Href="account" Icon="@Icons.Material.Filled.Person">Account</MudNavLink>
                    <MudNavLink OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">Log out</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Auth.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await Sync.StartAsync();
    }

    protected override void OnParametersSet() => EnforcePasswordChange();

    // A temporary password has to be replaced before anything else.
    private void EnforcePasswordChange()
    {
        if (Auth.User is { MustChangePassword: true } && Navigation.ToBaseRelativePath(Navigation.Uri) != "account")
        {
            Navigation.NavigateTo("account", replace: true);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        EnforcePasswordChange();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) => InvokeAsync(() =>
    {
        EnforcePasswordChange();
        StateHasChanged();
    });

    // Unsynced changes stay on the device through a logout and go up after the next login,
    // but say so rather than let someone assume they're gone or already saved.
    private async Task LogoutAsync()
    {
        var pending = Store.PendingCount;
        if (pending > 0)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync("Changes not synced yet",
                $"{pending} {(pending == 1 ? "change hasn't" : "changes haven't")} reached the server. "
                + "They'll stay on this phone and sync after the next login.",
                yesText: "Log out", cancelText: "Cancel");
            if (confirmed != true)
            {
                return;
            }
        }
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Auth.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
